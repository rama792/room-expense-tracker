rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomCode) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomCode)/members/$(request.auth.uid));
    }

    match /rooms/{roomCode} {
      // A room is created with an unpredictable invite code.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50;
      // The invite code is the room's bearer invitation; do not allow listing rooms.
      // Keep codes unguessable and share them only with intended roommates.
      allow get: if signedIn();
      allow list: if false;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      match /members/{memberUid} {
        allow get, list: if isMember(roomCode);
        // Knowing the room invite code lets a signed-in anonymous user join.
        // The member document ID must always equal that user's Firebase UID.
        allow create: if signedIn()
          && request.auth.uid == memberUid
          && exists(/databases/$(database)/documents/rooms/$(roomCode));
        allow update, delete: if signedIn()
          && request.auth.uid == memberUid
          && isMember(roomCode);
      }

      match /expenses/{expenseId} {
        allow get, list: if isMember(roomCode);
        allow create: if isMember(roomCode)
          && request.resource.data.payerUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 10000000
          && request.resource.data.payerName is string
          && request.resource.data.category is string
          && request.resource.data.date is string;
        // A member can edit/delete only their own expense.
        allow update, delete: if isMember(roomCode)
          && resource.data.payerUid == request.auth.uid
          && request.resource.data.payerUid == request.auth.uid;
      }
    }
  }
}
